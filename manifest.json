{
  "manifest_version": 3,
  "name": "AI Mode Popup",
  "version": "1.0.0",
  "description": "Show or hide Google AI Mode in a floating window with a global keyboard shortcut.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Google AI Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-ai-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Show or hide Google AI Mode",
      "global": true
    }
  }
}
